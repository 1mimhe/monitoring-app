# Environment Variables Reference
# Copy this file to .env in each version's directory and fill in the values.

# ============================================================
# Realtime Version (Realtime/.env)
# ============================================================
PORT=3000
DEBUG=false

# 
# REST Agent (REST/Agent/.env)
# ============================================================
PORT=3333============================================================

# ============================================================
# REST Central-Manager (REST/Central-Manager/.env)
# ============================================================
PORT=8000

# ============================================================
# Socket Agent (Socket/Agent/.env)
# ============================================================
AGENT_TCP_PORT=3333
AGENT_TCP_ADDRESS=0.0.0.0

# ============================================================
# Socket Central-Manager (Socket/Central-Manager/.env)
# ============================================================
CENTRAL_MANAGER_UDP_PORT=5000
CENTRAL_MANAGER_UDP_ADDRESS=0.0.0.0
# Comma-separated list of agent addresses in format ip:port
# Example: 192.168.1.10:3333,192.168.1.11:3333
AGENTS=
